-- ARRASTAR PAINEL
-- =================================

local arrastando = false
local inicioMouse
local inicioFrame

Topo.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        arrastando = true
        inicioMouse = input.Position
        inicioFrame = Frame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if arrastando and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then

        local delta = input.Position-inicioMouse

        Frame.Position = UDim2.new(
            inicioFrame.X.Scale,
            inicioFrame.X.Offset+delta.X,
            inicioFrame.Y.Scale,
            inicioFrame.Y.Offset+delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        arrastando = false
    end
end)

-- ARRASTAR O BOTAO MENU FLUTUANTE
local menuArrastando = false
local menuInicioMouse
local menuInicioPos

Menu.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        menuArrastando = true
        menuInicioMouse = input.Position
        menuInicioPos = Menu.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if menuArrastando and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position-menuInicioMouse
        Menu.Position = UDim2.new(
            menuInicioPos.X.Scale,
            menuInicioPos.X.Offset+delta.X,
            menuInicioPos.Y.Scale,
            menuInicioPos.Y.Offset+delta.Y
        )
        Frame.Position = Menu.Position
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        menuArrastando = false
    end
end)

