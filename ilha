local EntregaPrompt = Entrega:WaitForChild("ProximityPrompt")

local function StatusCaixa(texto)
    CaixaStatus.Text = "Status: "..texto
end

local function Posicao(obj)
    if obj:IsA("Attachment") then
        return obj.WorldPosition
    elseif obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") then
        return obj:GetPivot().Position
    end

    local part = obj:FindFirstAncestorWhichIsA("BasePart")
    return part and part.Position
end

local function Aproximar(obj,prompt)
    local root = Personagem()
    local target = Posicao(obj)

    if not root or not target then return nil end

    local direction = root.Position-target

    if direction.Magnitude <= prompt.MaxActivationDistance*0.55 then
        return root.Position
    end

    if direction.Magnitude < 0.1 then
        direction = Vector3.new(1,0,0)
    end

    local distance = math.max(
        1,math.min(prompt.MaxActivationDistance*0.55,5)
    )

    return target + direction.Unit*distance
end

local function MoverCaixa(position)
    local root,humanoid = Personagem()
    if not root or not humanoid then return false end
    if not Hub.CaixaAtivo then return false end

    -- Speed independente do Auto Varrer.
    humanoid.WalkSpeed = Hub.CaixaVelocidade

    -- Vai diretamente ao destino, sem calcular waypoints/curvas.
    humanoid:MoveTo(position)

    local terminou = false
    local chegou = false

    local connection = humanoid.MoveToFinished:Connect(function(result)
        chegou = result
        terminou = true
    end)

    local timeout = os.clock()+20

    while Hub.CaixaAtivo and not terminou and os.clock()<timeout do
        root,humanoid = Personagem()
        if not root or not humanoid then
            connection:Disconnect()
            return false
        end

        humanoid.WalkSpeed = Hub.CaixaVelocidade

        if (root.Position-position).Magnitude <= 3 then
            chegou = true
            terminou = true
            break
        end

        task.wait(0.1)
    end

    connection:Disconnect()
    return Hub.CaixaAtivo and chegou
end

local function Interagir(prompt)
    if not Hub.CaixaAtivo then return false end
    if not prompt.Parent or not prompt.Enabled then return false end

    local root = Personagem()
    local target = Posicao(prompt.Parent)

    if not root or not target then return false end

    if (root.Position-target).Magnitude >
        prompt.MaxActivationDistance+1 then
        return false
    end

    CaixaProgresso.Text = prompt.ActionText

    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt,prompt.HoldDuration)
        end)

        if ok then
            task.wait(prompt.HoldDuration+0.5)
            return Hub.CaixaAtivo
        end
    end

    local ok = pcall(function()
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration+0.3)
        prompt:InputHoldEnd()
    end)

    return ok and Hub.CaixaAtivo
end

local function EtapaCaixa(obj,prompt,nome)
    if not Hub.CaixaAtivo then return false end

    StatusCaixa("INDO PARA "..nome)
    CaixaProgresso.Text = "Calculando caminho..."

    local destino = Aproximar(obj,prompt)
    if not destino then return false end

    if not MoverCaixa(destino) then
        CaixaProgresso.Text = "Falha no caminho"
        return false
    end

    if not Hub.CaixaAtivo then return false end

    task.wait(0.3)

    local root = Personagem()
    local target = Posicao(prompt.Parent)

    if not root or not target then return false end

    if (root.Position-target).Magnitude >
        prompt.MaxActivationDistance then
        CaixaProgresso.Text = "Fora do alcance"
        return false
    end

    StatusCaixa("INTERAGINDO")
    return Interagir(prompt)
end

local function ExecutarCaixa()
    while Hub.CaixaAtivo do
        if not AdquirirMovimento("CAIXA",function()
            return Hub.CaixaAtivo
        end) then break end

        local sucesso = false

        local ok = pcall(function()
            StatusCaixa("INDO PEGAR CAIXA")

            local pegou = EtapaCaixa(
                Caixa,CaixaPrompt,"CAIXA"
            )

            if not pegou or not Hub.CaixaAtivo then return end

            StatusCaixa("INDO ENTREGAR")

            local entregou = EtapaCaixa(
                Entrega,EntregaPrompt,"ENTREGA"
            )

            if entregou and Hub.CaixaAtivo then
                CaixaProgresso.Text = "ENTREGA CONCLUIDA!"
                sucesso = true
            end
        end)

        LiberarMovimento("CAIXA")

        if not ok or not sucesso then
            break
        end

        task.wait(1)
    end

    Hub.CaixaAtivo = false
    LiberarMovimento("CAIXA")
    StatusCaixa("DESATIVADO")
    CaixaStart.Text = "▶ ATIVAR AUTO CAIXA"
    CorBotao(CaixaStart,Roxo)
end

