-- PERSONAGEM
local function Personagem()
    local char = Player.Character
    if not char then return nil,nil end

    return char:FindFirstChild("HumanoidRootPart"),
        char:FindFirstChildOfClass("Humanoid")
end

-- CONTROLE COMPARTILHADO DE MOVIMENTO
local function AdquirirMovimento(nome, ativo)
    while ativo() and Hub.Movimento ~= nil do
        task.wait(0.15)
    end

    if not ativo() then return false end

    Hub.Movimento = nome
    return true
end

local function LiberarMovimento(nome)
    if Hub.Movimento == nome then
        Hub.Movimento = nil
    end
end

