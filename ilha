local function atualizarSlider(x)
    local inicio, largura = Track.AbsolutePosition.X, Track.AbsoluteSize.X
    if largura <= 0 then return end
    local p = math.clamp((x - inicio) / largura, 0, 1)
    atualizarEscala(10 + p * 190)
end

