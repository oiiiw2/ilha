-- LOCALIZAR CAIXAS
local CaixaBase = Workspace
    :WaitForChild("Construcoes")
    :WaitForChild("PrisaoFolder")
    :WaitForChild("EmpregoPreso")

local Caixa = CaixaBase:WaitForChild("LocalCaixa")
