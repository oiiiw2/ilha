local function MinimizarPainel()
    if minimizado then return end
    minimizado = true
    Menu.Position = Frame.Position
    Menu.Visible = true
    Conteudo.Visible = false
    TweenService:Create(Frame,TweenInfo.new(
        0.22,Enum.EasingStyle.Quad,Enum.EasingDirection.In
    ),{
        Size = UDim2.fromOffset(350,0)
    }):Play()
    task.wait(0.23)
    Frame.Visible = false
end

local function RestaurarPainel()
    if not minimizado then return end
    minimizado = false
    Frame.Visible = true
    Frame.Size = UDim2.fromOffset(350,0)
    Conteudo.Visible = true
    Menu.Visible = false
    TweenService:Create(Frame,TweenInfo.new(
        0.25,Enum.EasingStyle.Back,Enum.EasingDirection.Out
    ),{
        Size = tamanhoNormal
    }):Play()
end

Minimizar.MouseButton1Click:Connect(MinimizarPainel)
Menu.MouseButton1Click:Connect(RestaurarPainel)

