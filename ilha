local Pasta = Workspace:WaitForChild("LocaisVarrer")
local Remote = ReplicatedStorage:WaitForChild("RemoteVarrer")

-- CONFIGURACOES DO AUTO VARRER
local DistanciaChegada = 5
local TempoVarredura = 5
local EsperaAposVarrer = 1
local TempoAntiRepeticao = 15
local ultimaVisita = {}

local function StatusVarrer(texto)
    VarrerStatus.Text = "Status: "..texto
end

-- Usa coordenadas para nao contar duas Parts sobrepostas
-- como locais diferentes.
local function ChaveLocal(posicao)
    return string.format("%d:%d:%d",
        math.floor(posicao.X/2+0.5),
        math.floor(posicao.Y/2+0.5),
        math.floor(posicao.Z/2+0.5)
    )
end

-- Busca dinamicamente todos os locais disponiveis na pasta.
local function ObterLocais()
    local locais = {}
    local vistos = {}

    for _,obj in ipairs(Pasta:GetDescendants()) do
        if obj:IsA("BasePart") then
            local chave = ChaveLocal(obj.Position)

            if not vistos[chave] then
                vistos[chave] = true
                table.insert(locais,{
                    part = obj,
                    pos = obj.Position,
                    chave = chave,
                    nome = obj.Name
                })
            end
        end
    end

    return locais
end

local function EscolherLocal()
    local locais = ObterLocais()

    if #locais == 0 then
        return nil,"NENHUM LOCAL ENCONTRADO"
    end

    local agora = os.clock()
    local disponiveis = {}

    for _,localInfo in ipairs(locais) do
        local ultima = ultimaVisita[localInfo.chave] or -math.huge

        if agora-ultima >= TempoAntiRepeticao then
            table.insert(disponiveis,localInfo)
        end
    end

    if #disponiveis == 0 then
        return nil,"AGUARDANDO ANTI-REPETICAO"
    end

    return disponiveis[math.random(1,#disponiveis)]
end

local function MoverVarrer(posicao)
    local maxTentativas = 3
    local distanciaWaypoint = 3

    for tentativa = 1, maxTentativas do
        if not Hub.VarrerAtivo then return false end

        local root, humanoid = Personagem()
        if not root or not humanoid then return false end

        -- Aplica a velocidade escolhida sem ficar reiniciando o movimento.
        local velocidade = math.clamp(tonumber(Hub.Velocidade) or 24, 8, 100)
        if humanoid.WalkSpeed ~= velocidade then
            humanoid.WalkSpeed = velocidade
        end

        local path = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            WaypointSpacing = 7
        })

        local calculou = pcall(function()
            path:ComputeAsync(root.Position, posicao)
        end)

        if not calculou or path.Status ~= Enum.PathStatus.Success then
            StatusVarrer("RECALCULANDO ROTA • " .. tentativa .. "/" .. maxTentativas)
            task.wait(0.2)
            continue
        end

        local rotaOK = true
        local waypoints = path:GetWaypoints()

        for _, waypoint in ipairs(waypoints) do
            if not Hub.VarrerAtivo then return false end

            root, humanoid = Personagem()
            if not root or not humanoid then return false end

            velocidade = math.clamp(tonumber(Hub.Velocidade) or 24, 8, 100)
            if humanoid.WalkSpeed ~= velocidade then
                humanoid.WalkSpeed = velocidade
            end

            if waypoint.Action == Enum.PathWaypointAction.Jump then
                humanoid.Jump = true
            end

            humanoid:MoveTo(waypoint.Position)

            local inicio = os.clock()
            local ultimaPosicao = root.Position
            local ultimoProgresso = os.clock()
            local chegou = false

            while Hub.VarrerAtivo do
                root, humanoid = Personagem()
                if not root or not humanoid then return false end

                velocidade = math.clamp(tonumber(Hub.Velocidade) or 24, 8, 100)
                if humanoid.WalkSpeed ~= velocidade then
                    humanoid.WalkSpeed = velocidade
                end

                local distanciaPonto = (root.Position - waypoint.Position).Magnitude
                local distanciaFinal = (root.Position - posicao).Magnitude
                VarrerDestino.Text = "Destino: " .. math.floor(distanciaFinal) .. " studs"

                if distanciaPonto <= distanciaWaypoint or distanciaFinal <= DistanciaChegada then
                    chegou = true
                    break
                end

                -- Mede apenas deslocamento horizontal para o pulo nao mascarar travamento.
                local delta = root.Position - ultimaPosicao
                local deslocamentoHorizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude

                if deslocamentoHorizontal >= 0.45 then
                    ultimaPosicao = root.Position
                    ultimoProgresso = os.clock()
                end

                if os.clock() - ultimoProgresso >= 2 then
                    StatusVarrer("PRESO • TENTANDO DESTRAVAR")
                    humanoid.Jump = true
                    task.wait(0.25)
                    rotaOK = false
                    break
                end

                if os.clock() - inicio >= 14 then
                    rotaOK = false
                    break
                end

                task.wait(0.06)
            end

            if not Hub.VarrerAtivo then return false end
            if not rotaOK or not chegou then
                rotaOK = false
                break
            end
        end

        if rotaOK then
            root = Personagem()
            if root and (root.Position - posicao).Magnitude <= DistanciaChegada then
                return true
            end
        end

        if tentativa < maxTentativas and Hub.VarrerAtivo then
            StatusVarrer("NOVA TENTATIVA DE ROTA • " .. tentativa .. "/" .. maxTentativas)
            task.wait(0.25)
        end
    end

    StatusVarrer("NAO FOI POSSIVEL ALCANCAR O LOCAL")
    return false
end

local function VarrerLocal(localInfo)
    if not Hub.VarrerAtivo then return false end

    local root,humanoid = Personagem()
    if not root or not humanoid then return false end

    if (root.Position-localInfo.pos).Magnitude > DistanciaChegada then
        StatusVarrer("AINDA NAO CHEGOU AO LOCAL")
        return false
    end

    if not localInfo.part or not localInfo.part.Parent then
        StatusVarrer("LOCAL INDISPONIVEL")
        return false
    end

    StatusVarrer("VARRANDO LOCAL")
    VarrerDestino.Text = "Destino: "..localInfo.nome

    -- Marca a visita no momento em que a varredura e iniciada.
    ultimaVisita[localInfo.chave] = os.clock()

    local enviado = pcall(function()
        Remote:FireServer(localInfo.part)
    end)

    if not enviado then
        StatusVarrer("FALHA AO INICIAR VARREDURA")
        return false
    end

    for i = TempoVarredura,1,-1 do
        if not Hub.VarrerAtivo then return false end

        StatusVarrer("VARRANDO • "..i.."s")
        task.wait(1)
    end

    if Hub.VarrerAtivo then
        StatusVarrer("ESPERANDO")
        task.wait(EsperaAposVarrer)
    end

    return Hub.VarrerAtivo
end

local function ExecutarVarrer()
    while Hub.VarrerAtivo do
        if not AdquirirMovimento("VARRER",function()
            return Hub.VarrerAtivo
        end) then
            break
        end

        local localInfo,erro = EscolherLocal()

        if not localInfo then
            StatusVarrer(erro)
            LiberarMovimento("VARRER")
            task.wait(0.25)
        else
            VarrerDestino.Text = "Destino: "..localInfo.nome
            StatusVarrer("INDO PARA LOCAL ALEATORIO")

            local ok = pcall(function()
                local chegou = MoverVarrer(localInfo.pos)

                if not Hub.VarrerAtivo then return end

                if chegou then
                    VarrerLocal(localInfo)
                else
                    StatusVarrer("TENTANDO OUTRO LOCAL")
                    task.wait(0.4)
                end
            end)

            LiberarMovimento("VARRER")

            if not ok then
                StatusVarrer("ERRO - REINICIANDO CICLO")
                task.wait(0.5)
            end
        end
    end

    Hub.VarrerAtivo = false
    LiberarMovimento("VARRER")
    StatusVarrer("DESATIVADO")
    VarrerDestino.Text = "Destino: Nenhum"
    VarrerStart.Text = "▶ ATIVAR AUTO VARRER"
    CorBotao(VarrerStart,Roxo)
end

